PORT=5000
NODE_ENV=production

# REQUIRED. The server refuses to start without it. In production it must be 32+ random
# characters and not a placeholder, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# REQUIRED in production: exact origin(s) of the deployed frontend, comma-separated,
# no trailing slash or path. (Development defaults to http://localhost:3000.)
CORS_ORIGIN=https://your-vercel-app.vercel.app

# Directory for users.json / messages.json. In production point this at a PERSISTENT volume
# (e.g. a Railway volume mounted at /data); otherwise all data is lost on every deploy/restart.
# DATA_DIR=/data
