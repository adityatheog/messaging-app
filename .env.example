# Used by docker-compose.yml. Copy to `.env` (git-ignored) and fill in.

# Required. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Exact origin(s) the browser loads the frontend from (comma-separated, no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Baked into the frontend bundle at build time. /api uses the nginx proxy to the backend container.
REACT_APP_API_URL=/api
