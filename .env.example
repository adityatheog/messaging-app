# Server Configuration (Server-only secrets)
PORT=3000
JWT_SECRET=your_jwt_secret_change_in_production
CORS_ORIGIN=http://localhost:5173,https://localhost,http://localhost,capacitor://localhost,app://localhost
DATA_DIR=./data
PRESENCE_TIMEOUT_MS=15000

# Client Configuration (Public build-time variables for native shells)
# In web deployment, /api is served relative to the origin.
# For native shells (Capacitor / Electron), set absolute URLs:
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# Firebase / Firestore Production Credentials (Phase 2 & Phase 4)
# Optional: Set service account JSON string or path for production Firestore Store
FIREBASE_SERVICE_ACCOUNT_JSON=
GCP_PROJECT=